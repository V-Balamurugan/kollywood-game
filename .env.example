# Firebase Configuration (Get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Media & Movie Data API Endpoints
VITE_WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
VITE_WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
VITE_WIKIPEDIA_REST_URL=https://en.wikipedia.org/api/rest_v1
VITE_WIKIMEDIA_COMMONS_URL=https://commons.wikimedia.org/wiki/Special:FilePath
VITE_WIKIDATA_WEB_URL=https://www.wikidata.org/wiki
